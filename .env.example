# ==============================================================================
# Cross-Cloud Agentic Platform - Environment Configuration Template
# ==============================================================================

# Google Cloud Control Plane
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_INIT=true
MEMORY_BANK_ID=lending-servicing-memory-bank

# AWS FastMCP Gateway (Cloud Run Streamable HTTP)
AWS_MCP_URL=https://aws-mcp-gateway-your-hash.us-central1.run.app
AWS_REGION=us-east-2
AWS_AURORA_CLUSTER=your-aurora-cluster-id
AWS_DATABASE_NAME=demo_servicing_db
AWS_S3_BUCKET=your-s3-bucket-name
